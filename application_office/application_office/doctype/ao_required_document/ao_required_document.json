   "fieldtype": "Check",
   "label": "Required",
   "default": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "upload_status",
   "fieldtype": "Select",
   "label": "Upload Status",
   "options": "Not Uploaded\nUploaded",
   "default": "Not Uploaded",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "review_status",
   "fieldtype": "Select",
   "label": "Review Status",
   "options": "Pending\nIn Review\nApproved\nCorrection Required",
   "default": "Pending",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "c1",
   "fieldtype": "Column Break",
   "label": "C1"
  },
  {
   "fieldname": "current_version",
   "fieldtype": "Int",
   "label": "Current Version",
   "read_only": 1
  },
  {
   "fieldname": "reviewer",
   "fieldtype": "Link",
   "label": "Reviewer",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "review_timestamp",
   "fieldtype": "Datetime",
   "label": "Review Timestamp",
   "read_only": 1
  },
  {
   "fieldname": "retention_category",
   "fieldtype": "Select",
   "label": "Retention Category",
   "options": "Identity Document\nEducational Record\nForm / Approval\nSubmission Evidence\nFinancial\nOther",
   "default": "Identity Document"
  },
  {
   "fieldname": "instructions",
   "fieldtype": "Small Text",
   "label": "Instructions",
   "read_only": 1
