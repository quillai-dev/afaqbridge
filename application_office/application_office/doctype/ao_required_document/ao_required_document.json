   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  },
  {
   "role": "AO Case Worker",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  },
  {
   "role": "AO Reviewer",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  }
 ],
