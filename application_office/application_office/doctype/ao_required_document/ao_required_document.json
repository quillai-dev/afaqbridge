{
 "doctype": "DocType",
 "name": "AO Required Document",
 "module": "Application Office",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "case",
   "fieldtype": "Link",
   "label": "Case",
   "options": "AO Application Case",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "read_only": 1,
   "fetch_from": "case.customer"
  },
  {
   "fieldname": "document_category",
   "fieldtype": "Data",
   "label": "Document Category",
   "reqd": 1,
   "in_list_view": 1
  },
  {
