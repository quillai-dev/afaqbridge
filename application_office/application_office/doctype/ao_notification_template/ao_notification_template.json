{
 "doctype": "DocType",
 "name": "AO Notification Template",
 "module": "Application Office",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "event_key",
   "fieldtype": "Data",
   "label": "Event Key",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "language",
   "fieldtype": "Data",
   "label": "Language",
   "default": "en",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "subject",
   "fieldtype": "Data",
   "label": "Subject",
   "reqd": 1
  },
  {
   "fieldname": "body",
   "fieldtype": "Text Editor",
   "label": "Body",
   "reqd": 1,
   "description": "Jinja. Variables: customer_name, case_reference, program_name, status_label, deadline, portal_url, message, office_name, disclaimer"
  }
 ],
 "permissions": [
  {
   "role": "AO Administrator",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  },
  {
   "role": "AO Case Worker",
   "permlevel": 0,
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  },
  {
   "role": "AO Auditor",
   "permlevel": 0,
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 0,
   "email": 0,
   "share": 0
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "editable_grid": 1,
 "row_format": "Dynamic",
 "autoname": "format:{event_key}-{language}",
 "naming_rule": "Expression"
}
