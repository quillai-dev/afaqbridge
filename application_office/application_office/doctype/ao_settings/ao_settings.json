{
 "doctype": "DocType",
 "name": "AO Settings",
 "module": "Application Office",
 "custom": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "s_general",
   "fieldtype": "Section Break",
   "label": "Legal Notices"
  },
  {
   "fieldname": "office_name",
   "fieldtype": "Data",
   "label": "Office Name",
   "reqd": 1
  },
  {
   "fieldname": "disclaimer_text",
   "fieldtype": "Text Editor",
   "label": "Disclaimer Text",
   "reqd": 1,
   "description": "Shown to customers at registration, on every service and in the portal footer. Must state the office does not guarantee acceptance/selection/immigration outcomes and gives no legal advice unless appropriately authorised. Have a lawyer review it for your jurisdictions."
  },
  {
   "fieldname": "terms_url",
   "fieldtype": "Data",
   "label": "Service Terms URL"
  },
  {
   "fieldname": "privacy_url",
   "fieldtype": "Data",
   "label": "Privacy Notice URL"
  },
  {
   "fieldname": "terms_version",
   "fieldtype": "Data",
   "label": "Terms Version",
   "default": "1",
   "reqd": 1
  },
  {
   "fieldname": "privacy_version",
   "fieldtype": "Data",
   "label": "Privacy Version",
   "default": "1",
   "reqd": 1
  },
  {
   "fieldname": "sensitive_data_consent_text",
   "fieldtype": "Small Text",
   "label": "Sensitive Data Consent Text",
   "reqd": 1
  },
  {
   "fieldname": "s_uploads",
   "fieldtype": "Section Break",
   "label": "Uploads"
  },
  {
   "fieldname": "max_upload_mb",
   "fieldtype": "Int",
   "label": "Max Upload Mb",
   "default": 10,
   "reqd": 1
  },
  {
   "fieldname": "allowed_extensions",
   "fieldtype": "Data",
   "label": "Allowed Extensions",
   "default": "pdf,jpg,jpeg,png",
   "reqd": 1,
   "description": "Comma separated. Content is also sniffed; extension alone is never trusted."
  },
  {
   "fieldname": "clamav_socket",
   "fieldtype": "Data",
   "label": "Clamav Socket",
   "description": "Optional path of a clamd UNIX socket; if set, uploads are scanned"
  },
  {
   "fieldname": "s_notify",
   "fieldtype": "Section Break",
   "label": "Notifications & Reminders"
  },
  {
   "fieldname": "reminder_days",
   "fieldtype": "Data",
   "label": "Reminder Days",
   "default": "14,7,3,1",
   "reqd": 1,
   "description": "Days before the deadline (program time zone) at which reminders are sent"
  },
  {
   "fieldname": "invoice_reminder_days",
   "fieldtype": "Int",
   "label": "Invoice Reminder Days",
   "default": 7,
   "description": "Remind about invoices unpaid this many days after due date"
  },
  {
   "fieldname": "s_retention",
   "fieldtype": "Section Break",
   "label": "Retention"
  },
  {
   "fieldname": "retention_rules",
   "fieldtype": "Table",
   "label": "Retention Rules",
   "options": "AO Retention Rule"
  },
  {
   "fieldname": "default_retention_years",
   "fieldtype": "Int",
   "label": "Default Retention Years",
   "default": 7,
   "reqd": 1
  },
  {
   "fieldname": "backup_retention_note",
   "fieldtype": "Small Text",
   "label": "Backup Retention Note",
   "description": "Document how long backups are kept. Deleted data may persist in backups until they expire."
  },
  {
   "fieldname": "s_docuseal",
   "fieldtype": "Section Break",
   "label": "DocuSeal"
  },
  {
   "fieldname": "docuseal_enabled",
   "fieldtype": "Check",
   "label": "Docuseal Enabled"
  },
  {
   "fieldname": "docuseal_base_url",
   "fieldtype": "Data",
   "label": "Docuseal Base Url"
  },
  {
   "fieldname": "docuseal_api_token",
   "fieldtype": "Password",
   "label": "Docuseal Api Token"
  },
  {
   "fieldname": "docuseal_webhook_secret",
   "fieldtype": "Password",
   "label": "Docuseal Webhook Secret",
   "description": "The whsec_... secret DocuSeal shows for the webhook"
  },
  {
   "fieldname": "docuseal_signer_role",
   "fieldtype": "Data",
   "label": "Docuseal Signer Role",
   "default": "First Party",
   "description": "Signer role name used in your DocuSeal templates"
  },
  {
   "fieldname": "s_security",
   "fieldtype": "Section Break",
   "label": "Staff Workflow"
  },
  {
   "fieldname": "service_accounts",
   "fieldtype": "Small Text",
   "label": "Service Accounts",
   "description": "Comma separated user IDs that are integrations/bots. They may NEVER create Official Submission records."
  }
 ],
 "permissions": [
  {
   "role": "AO Administrator",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 0,
   "delete": 0,
   "report": 0,
   "export": 0,
   "print": 0,
   "email": 0,
   "share": 0
  },
  {
   "role": "System Manager",
   "permlevel": 0,
   "read": 1,
   "write": 1,
   "create": 0,
   "delete": 0,
   "report": 0,
   "export": 0,
   "print": 0,
   "email": 0,
   "share": 0
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "editable_grid": 1,
 "row_format": "Dynamic",
 "issingle": 1
}
