# Copy to .env (make setup does this and generates secrets). NEVER commit .env. chmod 600 .env.
# ---- versions (pinned; see docs/repository-audit.md). Do not use floating tags in production.
ERPNEXT_VERSION=v16.51.1
CUSTOM_IMAGE=registry.example.com/application-office
CUSTOM_TAG=v16.51.1-ao1          # image you build with `make image` (frappe + erpnext + application_office)
PULL_POLICY=missing
DOCUSEAL_IMAGE=docuseal/docuseal
DOCUSEAL_TAG=3.3.2               # VERIFY this tag exists on your registry before first use
POSTGRES_IMAGE=postgres:17
# ---- project identity (keep! changing the Compose project name would create NEW, empty volumes)
COMPOSE_PROJECT_NAME=application-office
# ---- site: local development defaults. Existing deployments keep their current SITE_NAME (the site is NOT renamed).
SITE_NAME=afaqbridge.localhost
SITE_URL=http://afaqbridge.localhost:8088     # used for links in e-mails; production: https://<SITE_NAME>
DOCUSEAL_HOST=sign.afaqbridge.localhost
DOCUSEAL_FORCE_SSL=                            # production: same value as DOCUSEAL_HOST (enables HTTPS-only cookies)
# ---- web entry point (single nginx `edge`; Traefik removed)
EDGE_IMAGE=nginx:1.28.0-alpine
CERTBOT_IMAGE=certbot/certbot:v4.0.0
EDGE_HTTP_PORT=8088                            # dev only (MODE=dev): published on 127.0.0.1 only
EDGE_PROD_HTTP_PORT=80                         # MODE=prod only
EDGE_PROD_HTTPS_PORT=443                       # MODE=prod only
EDGE_BIND_ADDR=0.0.0.0                         # production only; use a specific IP if 80/443 are shared with other projects
TLS_CERT_NAME=afaqbridge
LETSENCRYPT_EMAIL=ops@example.com
CLIENT_MAX_BODY_SIZE=50m
# ---- secrets (generated by scripts/gen-secrets.sh; keep them in a secret manager as well)
DB_PASSWORD=
ADMIN_PASSWORD=
DOCUSEAL_DB_PASSWORD=
DOCUSEAL_SECRET_KEY_BASE=
BACKUP_PASSPHRASE_FILE=/root/.ao-backup-pass   # outside the repo and outside the backup dir
# ---- resources
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
