# Copy to .env (make setup does this and generates secrets). NEVER commit .env. chmod 600 .env.
# ---- versions (pinned; see docs/repository-audit.md). Do not use floating tags in production.
ERPNEXT_VERSION=v16.51.1
CUSTOM_IMAGE=registry.example.com/application-office
CUSTOM_TAG=v16.51.1-ao1          # image you build with `make image` (frappe + erpnext + application_office)
PULL_POLICY=missing
DOCUSEAL_IMAGE=docuseal/docuseal
DOCUSEAL_TAG=3.3.2               # VERIFY this tag exists on your registry before first use
POSTGRES_IMAGE=postgres:17
# ---- site
SITE_NAME=office.example.com
SITES_RULE=Host(`office.example.com`)
DOCUSEAL_HOST=sign.example.com
LETSENCRYPT_EMAIL=ops@example.com
# ---- secrets (generated by scripts/gen-secrets.sh; keep them in a secret manager as well)
DB_PASSWORD=
ADMIN_PASSWORD=
DOCUSEAL_DB_PASSWORD=
DOCUSEAL_SECRET_KEY_BASE=
BACKUP_PASSPHRASE_FILE=/root/.ao-backup-pass   # outside the repo and outside the backup dir
# ---- resources
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
