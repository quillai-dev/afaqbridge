# PROD: TLS termination, HTTP->HTTPS redirect, host-based routing. Certificates live in /etc/letsencrypt (volume).
include /etc/nginx/afaqbridge/common.inc;

ssl_certificate     /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

server {                                   # port 80: ACME challenge + redirect, nothing else
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server { listen 443 ssl default_server; server_name _; return 444; }

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_NAME};
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/afaqbridge/frappe-locations.inc;
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOCUSEAL_HOST};
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/afaqbridge/docuseal-locations.inc;
}
